<Window x:Class="Aeroscope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Aeroscope.App.ViewModels"
        xmlns:controls="clr-namespace:Aeroscope.App.Controls"
        xmlns:local="clr-namespace:Aeroscope.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Aeroscope" Height="760" Width="1280">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Margin" Value="0,1,12,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="local:MainWindow.ShowConnection" Executed="OnShowConnection" />
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Scope">
                <MenuItem Command="local:MainWindow.ShowConnection" />
                <MenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}" />
                <Separator />
                <MenuItem Header="_Auto-connect" IsCheckable="True" IsChecked="{Binding AutoConnect}"
                          ToolTip="Connect to the last scope as soon as it is in range, also at start-up" />
            </MenuItem>
        </Menu>

        <!-- Connection and what the scope reports about itself -->
        <StatusBar DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <StatusBar.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="4,0" />
                </Style>
            </StatusBar.Resources>
            <StatusBarItem MouseDoubleClick="OnStatusDoubleClick" ToolTip="Double-click to connect or disconnect (Ctrl+K)">
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem DataContext="{Binding Scope}" ToolTip="Power state">
                <TextBlock Text="{Binding Power}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem DataContext="{Binding Scope}" ToolTip="Battery level (raw) and state">
                <TextBlock Text="{Binding Battery, StringFormat=Battery {0}}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem DataContext="{Binding Scope}" ToolTip="Temperature">
                <TextBlock Text="{Binding Temperature}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem DataContext="{Binding Scope}" ToolTip="Frames received since connecting">
                <TextBlock Text="{Binding FramesReceived, StringFormat=Frames {0}}" />
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="10,0">
            <!-- Scope screen and acquisition controls -->
            <TabItem Header="Scope" DataContext="{Binding Acquisition}">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Grid.Column="0">
                        <!-- Where the scope is in a long frame cycle -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource Visible}}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontFamily="Consolas" Margin="8,0,0,0" MinWidth="230" />
                            <ProgressBar Height="6" VerticalAlignment="Center" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                                         IsIndeterminate="{Binding ProgressIndeterminate}"
                                         ToolTip="The whole frame cycle: the capture (from the time base and frame size, within about 0.3 s), then the transfer (by packets received)." />
                        </DockPanel>
                        <!-- Pans within a frame wider than the screen while zoomed in -->
                        <ScrollBar DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0"
                                   Visibility="{Binding CanPan, Converter={StaticResource Visible}}"
                                   Minimum="0" Maximum="{Binding FramePanMaximum}" ViewportSize="{Binding FramePanViewport}"
                                   SmallChange="{Binding FramePanSmallChange}" LargeChange="{Binding FramePanViewport}"
                                   Value="{Binding FramePanPosition}" ToolTip="Pan within the frame" />
                        <controls:WaveformView Traces="{Binding Screen.Traces}"
                                               VoltsPerDivision="{Binding Range.VoltsPerDivision}"
                                               SecondsPerDivision="{Binding ViewSecondsPerDivision}"
                                               CentreSeconds="{Binding ViewCentreSeconds}"
                                               MouseWheel="OnScreenMouseWheel"
                                               ToolTip="Wheel: step through the history (a frame, or a division in roll mode); Shift+wheel: 10 frames, or a screen. Ctrl+wheel: zoom. Orange: trigger level now; blue: the level the shown frame was taken with."
                                               CentreVolts="{Binding OffsetVolts}"
                                               TriggerLevelVolts="{Binding TriggerLevelVolts}"
                                               FrameTriggerLevelVolts="{Binding FrameTriggerLevelVolts}"
                                               ShowTrigger="{Binding HasTrigger}" />
                    </DockPanel>

                    <!-- History: scroll back through everything received while running -->
                    <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearHistoryCommand}" Margin="6,0,0,0"
                                ToolTip="Forget the recorded history" />
                        <Button DockPanel.Dock="Right" Content="Live" Command="{Binding GoLiveCommand}" Margin="6,0,0,0"
                                ToolTip="Follow the newest data" />
                        <Button DockPanel.Dock="Right" Content="+" Command="{Binding ZoomInCommand}" Padding="8,0" Margin="6,0,0,0"
                                ToolTip="Zoom in: roll mode, or a frame wider than the screen" />
                        <Button DockPanel.Dock="Right" Content="−" Command="{Binding ZoomOutCommand}" Padding="8,0" Margin="6,0,0,0"
                                ToolTip="Zoom out: over the roll recording, or to the whole frame" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding HistoryText}" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <ScrollBar Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding HasHistory}"
                                   Minimum="0" Maximum="{Binding HistoryMaximum}" ViewportSize="{Binding HistoryViewport}"
                                   SmallChange="{Binding HistorySmallChange}" LargeChange="{Binding HistoryLargeChange}"
                                   Value="{Binding HistoryPosition}" />
                    </DockPanel>

                    <!-- Readouts under the screen -->
                    <WrapPanel Grid.Row="2" Grid.Column="0" Margin="0,6,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,0,18,0" />
                                <Setter Property="FontFamily" Value="Consolas" />
                            </Style>
                        </WrapPanel.Resources>
                        <TextBlock Text="{Binding Range, StringFormat=CH {0}}" />
                        <TextBlock Text="{Binding HorizontalText}" />
                        <TextBlock Text="{Binding PeakToPeakText, StringFormat=Vpp {0}}" />
                        <TextBlock Text="{Binding MaximumText, StringFormat=Max {0}}" />
                        <TextBlock Text="{Binding MinimumText, StringFormat=Min {0}}" />
                        <TextBlock Text="{Binding MeanText, StringFormat=Mean {0}}" />
                    </WrapPanel>

                    <ScrollViewer Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Acquisition" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding RunStopText}" Command="{Binding RunStopCommand}" MinWidth="70"
                                        ToolTip="Run continuously, or stop (also a single shot). The scope's button does the same." />
                                <Button Content="Single" Command="{Binding SingleCommand}"
                                        ToolTip="Capture one frame, then stop. Turn auto trigger off to wait for a real edge. In roll mode, stop when the screen is full." />
                            </StackPanel>
                            <TextBlock Text="{Binding RunMode}" Foreground="Gray" Margin="0,4,0,0" />

                            <TextBlock Text="Vertical" Style="{StaticResource SectionHeader}" />
                            <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" />
                            <CheckBox Content="DC coupling" IsChecked="{Binding DcCoupled}" Margin="0,6,0,0" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="Offset" Style="{StaticResource Label}" />
                                <Button DockPanel.Dock="Right" Content="0" Command="{Binding ZeroOffsetCommand}" Padding="8,0" Margin="6,0,0,0" />
                                <TextBlock Text="{Binding OffsetText}" />
                            </DockPanel>
                            <Slider Minimum="-10" Maximum="10" SmallChange="0.1" LargeChange="1"
                                    Value="{Binding OffsetDivisions}" ToolTip="Voltage at the screen centre, in divisions" />

                            <TextBlock Text="Horizontal" Style="{StaticResource SectionHeader}" />
                            <ComboBox ItemsSource="{Binding TimeBases}" SelectedItem="{Binding TimeBase}" />
                            <TextBlock Text="Frame size" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding FrameSizes}" SelectedItem="{Binding FrameSize}" ItemStringFormat="{}{0} samples"
                                      IsEnabled="{Binding HasTrigger}"
                                      ToolTip="Samples per frame. 512 fills the screen; larger frames cover more time and are shown whole (zoom in with +), but take longer to capture and send (4096: about 2 s per frame)." />

                            <TextBlock Text="Trigger" Style="{StaticResource SectionHeader}" />
                            <StackPanel IsEnabled="{Binding HasTrigger}">
                                <ComboBox ItemsSource="{Binding TriggerEdges}" SelectedItem="{Binding TriggerEdge}" />
                                <CheckBox Content="Auto trigger" IsChecked="{Binding AutoTrigger}" Margin="0,6,0,0"
                                          ToolTip="Keep acquiring when no edge is found" />
                                <CheckBox Content="Noise reject" IsChecked="{Binding NoiseReject}" Margin="0,4,0,0"
                                          ToolTip="Only applies to a single edge" />
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="Level" Style="{StaticResource Label}" />
                                    <Button DockPanel.Dock="Right" Content="0" Command="{Binding ZeroTriggerLevelCommand}" Padding="8,0" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding TriggerLevelText}" />
                                </DockPanel>
                                <Slider Minimum="-4" Maximum="4" SmallChange="0.05" LargeChange="0.5"
                                        Value="{Binding TriggerLevelDivisions}" ToolTip="Trigger level, in divisions from the screen centre" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Protocol diagnostics -->
            <TabItem Header="Diagnostics">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Scope}" Margin="0,0,0,4">
                            <TextBlock Text="Firmware" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Firmware}" Margin="0,0,24,0" />
                            <TextBlock Text="Serial" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding SerialNumber}" />
                        </StackPanel>
                        <TextBlock Text="Characteristics" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <ListView ItemsSource="{Binding Characteristics}" MinHeight="60">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Role" Width="110" DisplayMemberBinding="{Binding Role}" />
                                    <GridViewColumn Header="UUID" Width="300" DisplayMemberBinding="{Binding Uuid}" />
                                    <GridViewColumn Header="Properties" Width="260" DisplayMemberBinding="{Binding Properties}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <StackPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Margin" Value="0,0,6,6" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="Raw commands" Style="{StaticResource SectionHeader}" />
                        <WrapPanel>
                            <Button Content="Power (QP)" Command="{Binding SendCommandCommand}" CommandParameter="QP" />
                            <Button Content="Telemetry (QTI)" Command="{Binding SendCommandCommand}" CommandParameter="QTI" />
                            <Button Content="Version (QVR)" Command="{Binding SendCommandCommand}" CommandParameter="QVR" />
                            <Button Content="Error log (QE)" Command="{Binding SendCommandCommand}" CommandParameter="QE" />
                            <Button Content="Calibration (QC)" Command="{Binding SendCommandCommand}" CommandParameter="QC" />
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Send settings" Command="{Binding SendSettingsCommand}"
                                    ToolTip="Write the FPGA registers for the settings on the Scope tab" />
                            <Button Content="Run (R)" Command="{Binding SendCommandCommand}" CommandParameter="R" />
                            <Button Content="Single (F)" Command="{Binding SendCommandCommand}" CommandParameter="F" />
                            <Button Content="Stop (S)" Command="{Binding SendCommandCommand}" CommandParameter="S" />
                            <Button Content="Cancel (X)" Command="{Binding SendCommandCommand}" CommandParameter="X" />
                            <Button Content="Full frame (L)" Command="{Binding SendCommandCommand}" CommandParameter="L" />
                        </WrapPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCustomCommandCommand}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding CustomCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                                     VerticalContentAlignment="Center" ToolTip="Any ASCII command for Scope In, e.g. QTI" />
                        </DockPanel>
                        <CheckBox Content="Log raw data packets" IsChecked="{Binding LogDataPackets}" Margin="0,6,0,0" />
                    </StackPanel>

                    <DockPanel Grid.Row="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,12,0,4">
                            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}" Margin="0" Padding="8,0" />
                            <TextBlock Text="Log" FontWeight="SemiBold" />
                        </DockPanel>
                        <ListBox x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Consolas"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:LogEntry">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TimeText}" Foreground="Gray" Width="100" />
                                        <TextBlock Text="{Binding KindText}" Width="60" />
                                        <TextBlock Text="{Binding Text}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
