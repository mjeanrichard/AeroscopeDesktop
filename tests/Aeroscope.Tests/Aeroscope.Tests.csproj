<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Same Windows target as the projects under test; UseWPF so the app's view models can be referenced -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aeroscope.Core\Aeroscope.Core.csproj" />
    <ProjectReference Include="..\..\src\Aeroscope.Probe\Aeroscope.Probe.csproj" />
    <ProjectReference Include="..\..\src\Aeroscope.App\Aeroscope.App.csproj" />
  </ItemGroup>

  <!-- Traffic recorded from a real Aeroscope (FPGA rev 5, firmware rev 5) with the probe tool -->
  <ItemGroup>
    <None Include="Captures\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The release workflow's version script -->
  <ItemGroup>
    <None Include="..\..\.github\scripts\next-version.ps1" Link="Scripts\next-version.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
